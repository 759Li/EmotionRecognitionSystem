# Database
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/emotion_recognition
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=emotion_recognition

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT & Flask
JWT_SECRET_KEY=your-jwt-secret-key
FLASK_SECRET_KEY=your-flask-secret-key

# SMTP (QQ mail)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code

# Model paths (relative to project root)
TEXT_MODEL_PATH=./p1_models_train/TextModel/nlp_structbert_emotion_classification_chinese_base
IMAGE_MODEL_DIR=./p1_models_train/LightGBM/model
LANDMARK_PATH=./p1_models_train/LightGBM/shape_predictor_68_face_landmarks.dat

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# Storage
STORAGE_BASE_PATH=./storage

# App
APP_URL=http://localhost:5000
APP_HOST=127.0.0.1
APP_PORT=5000
DEBUG=true
